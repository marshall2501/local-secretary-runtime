# Local Secretary Runtime environment template
# Copy this file to .env and edit values for your machine.
# Do NOT commit .env.

# === Profile ===
# Normally on sub-PC; use main-pc on manual failover.
LSA_PROFILE=sub-pc
LSA_ENV=local

# === Paths ===
LSA_ROOT=D:\AI
LSA_DATA_DIR=D:\AI\data
LSA_MODELS_DIR=D:\AI\models
LSA_BACKUP_DIR=D:\AI\data\backup

# === Runtime ===
LSA_HOST=127.0.0.1
LSA_API_PORT=8010
LSA_N8N_PORT=5678

# === Local LLM ===
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=

# === Airtable ===
AIRTABLE_BASE_ID=
AIRTABLE_API_KEY=

# === Cloud LLM APIs ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cloud MAGI is opt-in because it sends the current MAGI request to an external API
# and may incur API charges. ChatGPT subscriptions do not populate this API key.
LSA_MAGI_CLOUD_ENABLED=0
LSA_MAGI_CASPER_ENABLED=1
LSA_MAGI_CASPER_MODEL=gpt-5.6-sol
LSA_MAGI_CASPER_WEIGHT=1.0
LSA_MAGI_BALTHASAR_ENABLED=1
LSA_MAGI_BALTHASAR_MODEL=gpt-5.6-terra
LSA_MAGI_BALTHASAR_WEIGHT=1.0
LSA_MAGI_MELCHIOR_WEIGHT=1.0
OPENAI_BASE_URL=https://api.openai.com/v1

# === Logging ===
LOG_LEVEL=INFO
