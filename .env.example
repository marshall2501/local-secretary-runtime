# Local Secretary Runtime environment template
# Copy this file to .env and edit values for your machine.
# Do NOT commit .env.

# === Profile ===
# Normally on sub-PC; use main-pc on manual failover.
LSA_PROFILE=sub-pc
LSA_ENV=local

# === Paths ===
LSA_ROOT=D:\AI
LSA_DATA_DIR=D:\AI\data
LSA_MODELS_DIR=D:\AI\models
LSA_BACKUP_DIR=D:\AI\data\backup

# === Runtime ===
LSA_HOST=127.0.0.1
LSA_API_PORT=8010
LSA_N8N_PORT=5678

# === Local LLM ===
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=

# === Airtable ===
AIRTABLE_BASE_ID=
AIRTABLE_API_KEY=

# === LLM credentials / bootstrap defaults ===
# Normal MAGI provider/model/member assignments are stored in PostgreSQL after
# the first save. These values are only credentials and bootstrap/fallback
# defaults when the DB has no MAGI assignment yet.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ANTHROPIC_API_KEY=

# Legacy/global cloud bootstrap gate. DB-backed assignments supersede this.
LSA_MAGI_CLOUD_ENABLED=0

# Any MAGI member may use any supported provider/model.
# MELCHIOR example:
LSA_MAGI_MELCHIOR_PROVIDER=ollama
LSA_MAGI_MELCHIOR_MODEL=
LSA_MAGI_MELCHIOR_ENABLED=1
LSA_MAGI_MELCHIOR_WEIGHT=1.0
LSA_MAGI_MELCHIOR_TIMEOUT_SECONDS=120

# CASPER example:
LSA_MAGI_CASPER_PROVIDER=openai
LSA_MAGI_CASPER_MODEL=gpt-5.6-sol
LSA_MAGI_CASPER_ENABLED=0
LSA_MAGI_CASPER_WEIGHT=1.0
LSA_MAGI_CASPER_TIMEOUT_SECONDS=120

# BALTHASAR example:
LSA_MAGI_BALTHASAR_PROVIDER=gemini
LSA_MAGI_BALTHASAR_MODEL=
LSA_MAGI_BALTHASAR_ENABLED=0
LSA_MAGI_BALTHASAR_WEIGHT=1.0
LSA_MAGI_BALTHASAR_TIMEOUT_SECONDS=120

# === Logging ===
LOG_LEVEL=INFO
