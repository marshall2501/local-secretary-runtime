# Local Secretary Runtime environment template
# Copy this file to .env and edit values for your machine.
# Do NOT commit .env.

# === Profile ===
# Normally on sub-PC; use main-pc on manual failover.
LSA_PROFILE=sub-pc
LSA_ENV=local

# === Paths ===
LSA_ROOT=D:\AI
LSA_DATA_DIR=D:\AI\data
LSA_MODELS_DIR=D:\AI\models
LSA_BACKUP_DIR=D:\AI\data\backup

# === Runtime ===
LSA_HOST=127.0.0.1
LSA_API_PORT=8010
LSA_N8N_PORT=5678

# === Local LLM ===
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=

# === Airtable ===
AIRTABLE_BASE_ID=
AIRTABLE_API_KEY=

# === Cloud LLM APIs ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Logging ===
LOG_LEVEL=INFO
