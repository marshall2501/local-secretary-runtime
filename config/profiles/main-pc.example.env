# Main PC profile example
# Copy values into .env only when intentionally using the main PC.

LSA_PROFILE=main-pc
LSA_ROOT=D:\AI
LSA_DATA_DIR=D:\AI\data
LSA_MODELS_DIR=D:\AI\models
LSA_BACKUP_DIR=D:\AI\data\backup

# Main PC is the manual recovery/fallback host. Normal runtime is the sub PC.
LSA_HOST=127.0.0.1
LSA_API_PORT=8010
LSA_N8N_PORT=5678

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=
