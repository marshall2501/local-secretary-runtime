# Sub PC profile example
# Copy values into .env when using the normal runtime host.

LSA_PROFILE=sub-pc
LSA_ROOT=D:\AI
LSA_DATA_DIR=D:\AI\data
LSA_MODELS_DIR=D:\AI\models
LSA_BACKUP_DIR=D:\AI\data\backup

# Sub PC is the normal runtime host. Change ports only when a known local conflict requires it.
LSA_HOST=127.0.0.1
LSA_API_PORT=8010
LSA_N8N_PORT=5678

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=
